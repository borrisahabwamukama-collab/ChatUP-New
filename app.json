{
  "expo": {
    "name": "ChatUP",
    "slug": "chatup-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatup408.chatup",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow ChatUP to access your camera to record video tours and capture clips.",
        "NSMicrophoneUsageDescription": "Allow ChatUP to access your microphone for recording audio.",
        "NSLocationWhenInUseUsageDescription": "Allow ChatUP to access your location for mapping and emergency dispatch.",
        "NSContactsUsageDescription": "Allow ChatUP to access your contacts for messaging and connections."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.chatup408.chatup",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      "expo-camera",
      "expo-location",
      "expo-contacts"
    ],
    "extra": {
      "eas": {
        "projectId": "548e20fd-5e16-4a27-908b-99196a1686ef"
      }
    },
    "owner": "chatup408",
    "updates": {
      "url": "https://u.expo.dev/548e20fd-5e16-4a27-908b-99196a1686ef"
    }
  }
}
